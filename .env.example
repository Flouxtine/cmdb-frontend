# OpsScope 配置 —— 复制为 .env
PORT=8080
# 服务名（发布上报默认服务）
SERVICE_NAME=opsscope
# LLM（OpenAI 兼容，M3 使用；不填则规则回退）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 安全（可选）：CORS 白名单（逗号分隔，默认 * 仅适合内网/本地）
# CORS_ORIGINS=http://127.0.0.1:8080
# 告警 Webhook 鉴权令牌（M2 使用；留空不校验）
# WEBHOOK_TOKEN=
