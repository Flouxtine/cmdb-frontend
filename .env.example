# OpsScope 配置 —— 复制为 .env
PORT=8080
# 服务名（发布上报默认服务）
SERVICE_NAME=opsscope
# LLM（OpenAI 兼容，M3 使用；不填则规则回退）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 多模型源（可选，AI 排障 failover）：JSON 数组，按顺序尝试，失败自动切换下一个
# LLM_PROVIDERS=[{"name":"deepseek","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"moonshot","base_url":"https://api.moonshot.cn/v1","api_key":"sk-xxx","model":"moonshot-v1-8k"}]
# 安全（可选）：CORS 白名单（逗号分隔，默认 * 仅适合内网/本地）
# CORS_ORIGINS=http://127.0.0.1:8080
# 告警 Webhook 鉴权令牌（M2 使用；留空不校验）
# WEBHOOK_TOKEN=
# Webhook HMAC 签名密钥（推荐）：外部系统以 HMAC-SHA256(raw body) 计算签名，请求头带
# X-Ops-Scope-Signature=<hex>；未配置则回退 WEBHOOK_TOKEN 校验
# WEBHOOK_SECRET=
# 告警通知 Webhook（钉钉/飞书/自定义，告警触发/恢复时 POST JSON；留空不推送）
# ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# 内部采样与规则检测间隔（秒，默认 10）
# SAMPLE_INTERVAL=10
